{
  "name": "AnkiQuest-Dev",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.13-noble",
  "features": {
    "ghcr.io/devcontainers/features/nix:1.4.1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "postCreateCommand": "nix profile install .#devcontainer && ankiquest-devcontainer-setup",
  "customizations": {
    "vscode": {
      "extensions": ["mkhl.direnv", "jnoortheen.nix-ide"]
    }
  }
}
